# ============================================================================
# Контекст сборки Docker-образа микросервиса заявок.
# Всё, что перечислено ниже, НЕ попадает в build context (меньше передавать
# на демон, чище слои, выше шанс переиспользования кэша).
# ============================================================================

# --- Система контроля версий ------------------------------------------------
.git
.gitignore
.gitattributes

# --- Python: артефакты сборки и кэш интерпретатора ---------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/

# --- Тесты и отчёты (в образ продакшена не нужны) ----------------------------
tests/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# --- Логи и локальные данные ---------------------------------------------------
logs/
*.log

# --- Секреты и локальная конфигурация ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- IDE / ОС -------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Docker-файлы не нужны внутри контекста образа ------------------------------
Dockerfile
docker-compose.yml
.dockerignore

# --- Прочее ---------------------------------------------------------------------
README.md.bak
docs/_build/
