# ============================================================================
# Пример переменных для VPS (скопируйте в .env и заполните).
#
#   cp .env.example .env
#   nano .env
# ============================================================================

# --- PostgreSQL (внутри docker-сети; пароль ОБЯЗАТЕЛЬНО смените) ------------
POSTGRES_DB=tickets_db
POSTGRES_USER=tickets_app
POSTGRES_PASSWORD=change-me-strong-db-password

# --- HTTP API ----------------------------------------------------------------
# Порт на хосте, куда пробрасывается контейнер app (8080 внутри)
TICKETS_PUBLISH_PORT=8080
TICKETS_HOST=0.0.0.0
TICKETS_PORT=8080

# Публичный URL API (попадает в Swagger / OpenAPI servers)
# Без HTTPS:   http://YOUR_VPS_IP:8080
# С доменом:   https://api.example.com
PUBLIC_BASE_URL=http://YOUR_VPS_IP:8080

# --- CORS (обязательно для запросов с фронта) --------------------------------
# Origin вашего фронтенда, через запятую если несколько.
# Примеры:
#   https://app.example.com
#   https://app.example.com,http://localhost:5173
# Для быстрой проверки можно "*", но в проде указывайте конкретные origin.
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=0

# --- Ключи (смените перед выкладкой в интернет!) -----------------------------
TICKETS_API_KEY=change-me-gateway-secret-key
ACCESS_CONTROL_API_KEY=change-me-service-secret-key

# --- Модуль прав доступа -----------------------------------------------------
# Пусто => встроенный InMemoryAccessControlClient (демо-пользователи)
ACCESS_CONTROL_URL=
ACCESS_CONTROL_TIMEOUT=3.0

# 1 — демо-пользователи (admin_sidorov / manager_ivanov / …). На проде лучше 0.
SEED_DEMO_DATA=1
AUTO_CREATE_SCHEMA=1

# --- HTTPS (только для: docker compose --profile https up -d) ---------------
# Домен, на который смотрит DNS A-запись → IP VPS
DOMAIN=api.example.com

# --- Логирование -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/ticket_service.log
LOG_MAX_BYTES=10485760
BACKUP_COUNT=5
LOG_JSON=0
AUDIT_LOG_ENABLED=1
SQL_ECHO=0

# --- Кеширование -------------------------------------------------------------
CACHE_ENABLED=1
CACHE_TICKET_TTL=60
CACHE_LIST_TTL=15
CACHE_HISTORY_TTL=30
CACHE_MAX_ENTRIES=1024
# Для profile cache: REDIS_URL=redis://redis:6379/0
REDIS_URL=
REDIS_CACHE_PREFIX=tickets

# --- Уведомления -------------------------------------------------------------
NOTIFICATIONS_ENABLED=1
NOTIFY_AUTHOR=1
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_TIMEOUT=3.0
NOTIFICATION_INBOX_SIZE=500
