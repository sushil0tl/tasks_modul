# --- Хранилище -------------------------------------------------------------
TICKETS_DATABASE_URL=postgresql://tickets_app:tickets_pass@127.0.0.1:5433/tickets_db

# --- Сервер ----------------------------------------------------------------
TICKETS_HOST=0.0.0.0
TICKETS_PORT=9090

# --- Ключи -----------------------------------------------------------------
# Ключ вызывающей стороны (API-шлюз/фронтенд) для обращений к этому сервису
TICKETS_API_KEY=gateway-secret-key
# Ключ, которым этот сервис подписывает запросы в модуль прав доступа
ACCESS_CONTROL_API_KEY=service-secret-key

# --- Модуль прав доступа ---------------------------------------------------
# Пусто => используется встроенный InMemoryAccessControlClient (только для dev)
ACCESS_CONTROL_URL=
ACCESS_CONTROL_TIMEOUT=3.0

# 1 - загрузить демо-пользователей (admin/manager/engineer)
SEED_DEMO_DATA=1

# --- Логирование -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/ticket_service.log
LOG_MAX_BYTES=10485760
BACKUP_COUNT=5
LOG_JSON=0
AUDIT_LOG_ENABLED=1
SQL_ECHO=0

# --- Кеширование ---------------------------------------------------------------
CACHE_ENABLED=1
CACHE_TICKET_TTL=60
CACHE_LIST_TTL=15
CACHE_HISTORY_TTL=30
CACHE_MAX_ENTRIES=1024
# Redis для распределённого кэша (пусто -> только in-process LRU-кэш)
REDIS_URL=
REDIS_CACHE_PREFIX=tickets

# --- Уведомления ----------------------------------------------------------------
NOTIFICATIONS_ENABLED=1
NOTIFY_AUTHOR=1
# webhook для отправки уведомлений (пусто -> консоль + журнал в памяти/БД)
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_TIMEOUT=3.0
NOTIFICATION_INBOX_SIZE=500
